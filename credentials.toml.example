# Copy this file to credentials.toml and fill in your own details.
#
#     copy credentials.toml.example credentials.toml
#
# NEVER COMMIT credentials.toml. An API token is equivalent to your password
# for API purposes. The file is gitignored; keep it that way, and leave it
# behind if you copy this project anywhere.
#
# Create a token at:  id.atlassian.com -> Security -> API tokens
# Revoke it in the same place if it is ever exposed.
#
# You can skip this file entirely - if it is missing, Bulklogger asks for your
# email and token on first run and writes the file for you.

email = "you@mozilla.com"
api_token = "PASTE-YOUR-API-TOKEN-HERE"
